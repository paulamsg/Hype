generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int       @id @default(autoincrement())
  name        String
  lastName    String
  username    String    @unique
  email       String    @unique
  password    String
  location    String
  bio         String?
  avatarUrl   String?
  createdAt   DateTime  @default(now())

  savedEvents   SavedEvent[]
  following     Follow[]       @relation("following")
  followers     Follow[]       @relation("followers")
  receivedNotifications Notification[] @relation("receivedNotifications")
  sentNotifications     Notification[] @relation("sentNotifications")
  groupMembers  GroupMember[]
  photos        Photo[]   

  sentRequests     FollowRequest[] @relation("sentRequests")
  receivedRequests FollowRequest[] @relation("receivedRequests")
                     
}

model SavedEvent {
  id        Int       @id @default(autoincrement())
  userId    Int
  eventId   String
  name      String?
  date      String?
  time      String?
  venue     String?
  city      String?
  image     String?
  category  String?
  genre     String?
  subGenre  String?
  priceMin  Float?
  priceMax  Float?
  url       String?
  folder    Folder    @default(WANT_GO)
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id])
  photos    Photo[]                           

  @@unique([userId, eventId])
}

enum Folder {
  WANT_GO
  GOING
  GONE
  EXPIRED
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower    User     @relation("following", fields: [followerId], references: [id])
  following   User     @relation("followers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  senderId  Int?
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation("receivedNotifications", fields: [userId], references: [id])
  sender    User?    @relation("sentNotifications", fields: [senderId], references: [id])
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DENIED
}

model FollowRequest {
  id          Int             @id @default(autoincrement())
  senderId    Int
  receiverId  Int
  status      RequestStatus   @default(PENDING)
  createdAt   DateTime        @default(now())

  sender      User            @relation("sentRequests", fields: [senderId], references: [id])
  receiver    User            @relation("receivedRequests", fields: [receiverId], references: [id])

  @@unique([senderId, receiverId])

}

model Group {
  id        Int      @id @default(autoincrement())
  name      String
  createdBy Int
  createdAt DateTime @default(now())

  members   GroupMember[]
  events    GroupEvent[]
}

model GroupMember {
  id        Int      @id @default(autoincrement())
  groupId   Int
  userId    Int
  createdAt DateTime @default(now())

  group     Group    @relation(fields: [groupId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

model GroupEvent {
  id        Int      @id @default(autoincrement())
  groupId   Int
  eventId   String
  userId    Int
  createdAt DateTime @default(now())

  group     Group    @relation(fields: [groupId], references: [id])
}

model MockEvent {
  id         String   @id
  name       String
  date       String
  time       String
  venue      String
  city       String
  image      String
  category   String
  genre      String
  subGenre   String
  priceMin   Float
  priceMax   Float
  url        String
  featured   Boolean  @default(false)
}

model Photo {
  id            Int        @id @default(autoincrement())
  url           String
  createdAt     DateTime   @default(now())
  userId        Int
  savedEventId  Int

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedEvent    SavedEvent @relation(fields: [savedEventId], references: [id], onDelete: Cascade)
}